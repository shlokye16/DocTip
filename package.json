{
  "name": "sachacks-bias-check",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "uv sync && npm install && npm run train",
    "train": "uv run python train.py",
    "wsp": "uv run python wsp_edit.py",
    "wsp:fallback": "uv run python wsp_edit.py --fallback",
    "dev:api": "uv run fastapi dev server.py --port 8000",
    "dev:web": "vite",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "test": "uv run python test_engine.py && uv run python test_wsp.py && uv run python test_api.py",
    "eval:judge": "uv run python eval_judge.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
